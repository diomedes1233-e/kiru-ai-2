version: '3.8'

services:
  mi-api-local:
    build: ./mi-api-local
    container_name: kiru_api_local
    ports:
      - "8000:8000"
    environment:
      - OLLAMA_HOST=http://kiru_ollama:11434
      - DATABASE_URL=postgresql://postgres:postgres@kiru_postgres:5432/kiru
    volumes:
      - kiru_data:/app/data
    depends_on:
      - kiru_ollama
      - kiru_postgres
      - kiru_redis
    restart: unless-stopped

volumes:
  kiru_data:

